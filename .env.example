# Copiar a .env en la raíz para Docker Compose.
# Supabase > Connect: Project URL y publishable key (sb_publishable_...).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# Solo en FastAPI; nunca usar NEXT_PUBLIC_ con estos valores.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA
